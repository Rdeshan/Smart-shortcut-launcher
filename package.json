{
  "name": "shortcut-launcher",
  "version": "1.0.0",
  "description": "Boost your productivity with global keyboard shortcuts",
  "main": "main.js",
  "author": "Ravindu perera",
  "license": "Commercial",
  "homepage": "https://yourwebsite.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rdeshan/Smart-shortcut-launcher.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.Rdeshan.shortcutlauncher",
    "productName": "Shortcut Launcher",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "yourcompany",
      "repo": "shortcut-launcher"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.1.7"
  }
}
